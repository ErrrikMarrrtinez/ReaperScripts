desc:Strobe Tuner
//tags:strobe tuner
//author:Russ1642
/*
Strobe Tuner v0.3
2016-01-04

Uses the Left Channel

Version 0.3 Changes
 - overhauled light drawing algorithm, again

Version 0.2 Changes
 - adjusted light drawing algorithm


*/

slider1:9<1,12,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>Note
slider2:4<-1,9,1>Octave
slider3:0<-50,50,0.001>Cents Adjustment
slider4:0<-1,1,0.001>Fine Cents Adjustment
slider5:440<429,460,1>A4 Frequency
slider6:1<1,16,1>Harmonic
slider7:-120<-120,0,1>Noise Floor
slider8:20<4,50,1>Number of Lights
slider9:0.01<0.0001,1,0.0001>Fade Time

@init
light_r=1;
light_g=0.3;
light_b=0.3;

txt_r=0.5;
txt_g=0.5;
txt_b=0.5;

//maxspl[0]=0;
//maxspl[1]=0;

@slider
numlights=slider8;
notenumber=12*(floor(slider2)-1)+slider1+4;
notefreq=slider5*2^((notenumber-49)/12);
strobefreq=notefreq*2^((slider3+slider4)/1200)*slider6;
noisefloor=10^(slider7/20);
fade=1/(slider9*srate);

@sample
trip==1 ? (
pmax=maxspl;
maxspl=0;
trip=0;
);
maxspl=max(maxspl,spl0);
gainer=1/pmax;
gainer>(1/noisefloor) ? gainer = 0;

lightnum = floor(angle * numlights / (2*$pi))+1;

i=0;
loop(numlights,
i+=1;
i!=lightnum ? (
  light[i]-=fade;
  light[i]=max(light[i],0);
  ) : (
    (spl0>0) ? (
    light[i]=gainer*spl0;
    light[i]=min(light[i],1);
    ) : (
    light[i]-=fade;
    );
  );
);


angle += 2*$pi*strobefreq/srate;
(angle >= 2.0*$pi) ? (
angle -= 2.0*$pi;
trip=1;
);

@gfx 300 300

h = min(0.9*gfx_w,0.9*gfx_h);
circle_radius=0.95*h*sin($pi/numlights)/(2+2*sin($pi/numlights));
overall_radius=h/2-circle_radius;

k=0;
loop(numlights,
k+=1;
gfx_r=light_r*light[k];
gfx_g=light_g*light[k];
gfx_b=light_b*light[k];

xpos=(overall_radius)*cos(2*$pi*(k-1)/numlights)+gfx_w/2;
ypos=-(overall_radius)*sin(2*$pi*(k-1)/numlights)+gfx_h/2;
gfx_circle(xpos,ypos,circle_radius,1);
);

strcpy_fromslider(0, slider1);
gfx_setfont(1,"Arial",26);
gfx_measurestr("U",str_w,str_h);

gfx_r=txt_r;
gfx_g=txt_g;
gfx_b=txt_b;
gfx_x = 2;
gfx_y = 2;
gfx_drawstr(0);
gfx_drawnumber(slider2,0);
gfx_y+=str_h;
gfx_x=2;
gfx_drawnumber(slider3+slider4,2);
gfx_drawstr("c");
gfx_y+=str_h;
gfx_x=2;
gfx_drawnumber(strobefreq,3);
gfx_drawstr("Hz");